# ==============================================================================
# LearnioX Central Environment Configuration Template (.env.example)
# Copy this file to '.env' in the project root directory before running docker compose.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=learniox
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/learniox

# ------------------------------------------------------------------------------
# 2. Security & Token Secrets
# Note: SECRET_KEY must be at least 32 characters long.
# ------------------------------------------------------------------------------
SECRET_KEY=learniox_super_secret_jwt_key_2026_dev_environment_key_32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
WEBHOOK_SECRET=dev_webhook_secret_key_change_in_production

# ------------------------------------------------------------------------------
# 3. Development Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True

# ------------------------------------------------------------------------------
# 4. Service Mesh / Gateway Topology
# ------------------------------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
SERVER_SERVICE_URL=http://server-service:8000
AI_SERVICE_URL=http://ai-service:8001
MARKETING_SERVICE_URL=http://marketing-service:8002

# ------------------------------------------------------------------------------
# 5. Redis Cache & Rate Limiter
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# 6. Frontend Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost/api/v1

# ------------------------------------------------------------------------------
# 7. OAuth Credentials (Optional for local dev)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# ------------------------------------------------------------------------------
# 8. SMTP / Email Configuration
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME="LearnioX Platform"
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 9. Ngrok Public Tunneling Configuration (Optional)
# ------------------------------------------------------------------------------
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# ------------------------------------------------------------------------------
# 9. AI Service & Assessment Intelligence Configuration
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001

# ------------------------------------------------------------------------------
# 10. Speech-to-Text & Lecture Transcription Testing Module
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
MAX_TRANSCRIPTION_FILE_SIZE_MB=100
TRANSCRIPTION_STORAGE_DIR=/app/storage/lecture_transcription_test

# ------------------------------------------------------------------------------
# 11. Payment Gateway Configuration (razorpay | stripe | mock)
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# 12. Storage Provider Configuration (local | r2 | s3)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=learniox-media
R2_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=learniox-media
S3_REGION=ap-south-1

# ------------------------------------------------------------------------------
# 13. Certificate Generation Configuration
# ------------------------------------------------------------------------------
CERTIFICATE_ISSUER="LearnioX Platform"
CERTIFICATE_BASE_URL="http://localhost:3000/cert"

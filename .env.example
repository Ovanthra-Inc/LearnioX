# ==============================================================================
# LearnioX Central Environment Variables Template (.env.example)
# Copy this file to '.env' in the project root directory before deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Runtime, Environment & Debug Mode
# ------------------------------------------------------------------------------
PROJECT_NAME="LearnioX Platform"
ENVIRONMENT=development
DEBUG=True
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# 2. Centralized Structured Logging & Observability (SRE Standard)
# ------------------------------------------------------------------------------
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# LEARNIOX_LOG_DIR: Shared volume mount location for JSON rotating logs
LEARNIOX_LOG_DIR=/var/log/learniox
# LOG_FILE_MAX_BYTES: 25MB (26214400 bytes) default before rotation
LOG_FILE_MAX_BYTES=26214400
# LOG_FILE_BACKUP_COUNT: Number of rotated log archives to preserve per service
LOG_FILE_BACKUP_COUNT=10
# APPLICATIONINSIGHTS_CONNECTION_STRING: Azure Application Insights OpenTelemetry connection string
# Leave empty to cleanly disable cloud telemetry during local offline development
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ------------------------------------------------------------------------------
# 3. Security, Authentication & Cryptographic Secrets
# ------------------------------------------------------------------------------
SECRET_KEY=learniox_super_secret_jwt_key_2026_dev_environment_key_32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
INTERNAL_API_KEY=learniox_internal_diagnostic_key_2026
WEBHOOK_SECRET=dev_webhook_secret_key_change_in_production
SUPERADMIN_EMAILS=["admin@learniox.com"]

# ------------------------------------------------------------------------------
# 4. PostgreSQL Database & Async Connection Pool (Tuned for 1k VUs)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=learniox
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/learniox

# Connection pool settings (max connections per worker)
DB_POOL_SIZE=25
DB_MAX_OVERFLOW=15
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 5. Redis Cache, Pub/Sub & Distributed Locks
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379
REDIS_DB=0

# ------------------------------------------------------------------------------
# 6. Cache TTL Fine-Tuning (Seconds)
# ------------------------------------------------------------------------------
CACHE_TTL_USER_PROFILE=300
CACHE_TTL_RBAC_PERMS=60
CACHE_TTL_COURSE_LISTING=120
CACHE_TTL_INSTITUTION=600
CACHE_TTL_SEARCH=30
CACHE_TTL_DISCOVERY=60
CACHE_TTL_ANALYTICS=300

# ------------------------------------------------------------------------------
# 7. API Gateway (BFF) Topology & Rate Limiting
# ------------------------------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_RATE_LIMIT_WINDOW_MS=60000
GATEWAY_RATE_LIMIT_MAX=300
GATEWAY_RATE_LIMIT_DEFAULT="300/minute"

# Microservice Target URLs (Internal Docker Network)
SERVER_SERVICE_URL=http://server-service:8000
AI_SERVICE_URL=http://ai-service:8001
LIVE_SERVICE_URL=http://live-service:8003
MARKETING_SERVICE_URL=http://marketing-service:8002

# ------------------------------------------------------------------------------
# 8. Live Virtual Classroom & WebSocket Hub (live-service:8003)
# ------------------------------------------------------------------------------
LIVE_SERVICE_PORT=8003
JOIN_TICKET_EXPIRE_SECONDS=120
# MEDIA_PROVIDER: dev | livekit
MEDIA_PROVIDER=dev
LIVEKIT_URL=wss://livekit.learniox.local
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Classroom policies & high-concurrency throttling
MAX_PARTICIPANTS_PER_CLASS=1000
REACTION_BATCH_INTERVAL_MS=200
CHAT_RATE_LIMIT_PER_SEC=0.5
ATTENDANCE_MIN_PERCENTAGE_PRESENT=75.0
ATTENDANCE_MIN_PERCENTAGE_LATE=50.0

# ------------------------------------------------------------------------------
# 9. AI Service & Assessment Intelligence (ai-service:8001)
# ------------------------------------------------------------------------------
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
# GEMINI_API_KEY: Empty allows zero-dependency deterministic simulation fallback
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=4096
AI_RATE_LIMIT_PER_MINUTE=30

# ------------------------------------------------------------------------------
# 10. Speech-to-Text & Lecture Transcription Testing Module
# ------------------------------------------------------------------------------
# OPENAI_API_KEY: Empty allows deterministic offline timestamped transcript fallback
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
MAX_TRANSCRIPTION_FILE_SIZE_MB=100
TRANSCRIPTION_STORAGE_DIR=/app/storage/lecture_transcription_test

# ------------------------------------------------------------------------------
# 11. Payment Gateway Configuration (mock | razorpay | stripe)
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=mock

# Razorpay (India-first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe (Global)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 12. Media Storage & Zero-RAM Offload (local | r2 | s3)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5120

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=learniox-media
R2_PUBLIC_URL=

# AWS S3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=learniox-media
S3_REGION=ap-south-1

# ------------------------------------------------------------------------------
# 13. Certificate Generation Authority
# ------------------------------------------------------------------------------
CERTIFICATE_ISSUER="LearnioX Platform"
CERTIFICATE_BASE_URL="http://localhost:3000/cert"

# ------------------------------------------------------------------------------
# 14. Google OAuth Social Authentication
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

# ------------------------------------------------------------------------------
# 15. SMTP / Transactional Email Service
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
EMAILS_FROM_EMAIL=no-reply@learniox.com
EMAILS_FROM_NAME="LearnioX Platform"

# ------------------------------------------------------------------------------
# 16. Frontend Client & Networking Configuration (client-service:3000)
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost/api/v1
INTERNAL_API_URL=http://localhost/api/v1
API_GATEWAY_INTERNAL_URL=http://api-gateway:8080/api/:path*

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:8000", "http://localhost:8080", "http://localhost"]

# ------------------------------------------------------------------------------
# 17. Nginx Ingress & Ngrok Public HTTPS Tunneling
# ------------------------------------------------------------------------------
NGINX_PORT=80
NGINX_SSL_PORT=443
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

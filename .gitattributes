# ==============================================================================
# LearnioX Git Attributes & Line Endings Configuration
# ==============================================================================

# Default rule: Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicitly ensure shell and configuration scripts use LF (required for Docker containers)
*.sh text eol=lf
*.bash text eol=lf
Dockerfile* text eol=lf
*.conf text eol=lf

# Windows PowerShell scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Common web and source files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.db binary
*.sqlite binary
*.sqlite3 binary

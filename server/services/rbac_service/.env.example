APP_NAME=learniox-rbac-service
SERVICE_NAME=rbac_service
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/rbac_db
REDIS_URL=redis://localhost:6379/3

INTERNAL_API_KEY=dev-internal-secret
AUTH_SERVICE_URL=http://localhost:8000
USER_SERVICE_URL=http://localhost:8001
NOTIFICATION_SERVICE_URL=http://localhost:8010
AUDIT_SERVICE_URL=http://localhost:8011

LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

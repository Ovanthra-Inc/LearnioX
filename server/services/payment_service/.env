APP_NAME=learniox-payment-service
SERVICE_NAME=payment_service
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5434/payment_db
REDIS_URL=redis://localhost:6379/5

INTERNAL_API_KEY=dev-internal-secret
ENROLLMENT_SERVICE_URL=http://localhost:8006
NOTIFICATION_SERVICE_URL=http://localhost:8010
AUDIT_SERVICE_URL=http://localhost:8021

# Razorpay — replace with real keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=INFO

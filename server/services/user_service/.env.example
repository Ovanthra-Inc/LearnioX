APP_NAME=learniox-user-service
SERVICE_NAME=user_service
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/user_db

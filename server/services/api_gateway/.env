APP_NAME=learniox-api-gateway
SERVICE_NAME=api_gateway
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1
REDIS_URL=redis://localhost:6379/15
INTERNAL_API_KEY=dev-internal-secret

# Must match auth_service JWT_SECRET_KEY exactly
JWT_SECRET_KEY=change-me-dev-jwt-key-2026-very-secure-random
JWT_ALGORITHM=HS256

AUTH_SERVICE_URL=http://localhost:8000
USER_SERVICE_URL=http://localhost:8001
INSTITUTION_SERVICE_URL=http://localhost:8003
RBAC_SERVICE_URL=http://localhost:8002
COURSE_SERVICE_URL=http://localhost:8004
LESSON_SERVICE_URL=http://localhost:8005
ENROLLMENT_SERVICE_URL=http://localhost:8006
PROGRESS_SERVICE_URL=http://localhost:8007
SEARCH_SERVICE_URL=http://localhost:8008
ANALYTICS_SERVICE_URL=http://localhost:8009
NOTIFICATION_SERVICE_URL=http://localhost:8010
AI_SERVICE_URL=http://localhost:8012
REVIEW_SERVICE_URL=http://localhost:8011
AUDIT_SERVICE_URL=http://localhost:8010
MEDIA_SERVICE_URL=http://localhost:8099
MEMBERSHIP_SERVICE_URL=http://localhost:8098
PAYMENT_SERVICE_URL=http://localhost:8097
QUIZ_SERVICE_URL=http://localhost:8013
ASSIGNMENT_SERVICE_URL=http://localhost:8014
CERTIFICATE_SERVICE_URL=http://localhost:8015
DOUBT_SERVICE_URL=http://localhost:8016
COMMUNITY_SERVICE_URL=http://localhost:8017
LANDING_PAGE_SERVICE_URL=http://localhost:8018
MARKETING_SERVICE_URL=http://localhost:8019
ADMIN_SERVICE_URL=http://localhost:8020
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
RATE_LIMIT_PER_MINUTE=120
REQUEST_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
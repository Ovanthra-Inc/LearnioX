# ==============================================================================
# LearnioX Root .dockerignore
# ==============================================================================

# ── 1. Version Control ────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes
.github/

# ── 2. Secrets & Environment Files ────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── 3. Python Cache & Build Artifacts ─────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# ── 4. Virtual Environments ───────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── 5. Node / Frontend Artifacts ──────────────────────────────────────────────
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*

# ── 6. Storage, Databases & Volumes ───────────────────────────────────────────
*.db
*.sqlite*
postgres_data/
redis_data/
uploads_data/
uploads/*
!uploads/.gitkeep
storage/*
!storage/.gitkeep

# ── 7. Documentation, IDE & OS ────────────────────────────────────────────────
README.md
docs/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

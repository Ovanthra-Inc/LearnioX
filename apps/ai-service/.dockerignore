# ==============================================================================
# LearnioX ai-service .dockerignore
# ==============================================================================

# Git & Version Control
.git/
.gitignore
.gitattributes

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.cache/
.huggingface/

# Virtual Environments
venv/
.venv/
env/
.env
.env.*
!.env.example

# Local Media & Storage Files
*.db
*.sqlite
uploads/*
!uploads/.gitkeep
images/*
!images/.gitkeep
videos/*
!videos/.gitkeep
pdfs/*
!pdfs/.gitkeep
thumbnails/*
!thumbnails/.gitkeep
storages/*
!storages/.gitkeep
storage/*
!storage/.gitkeep
models/*

# Documentation & IDE
.vscode/
.idea/
*.swp
README.md
.DS_Store
Thumbs.db

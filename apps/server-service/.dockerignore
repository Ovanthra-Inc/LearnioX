# ==============================================================================
# LearnioX server-service .dockerignore
# ==============================================================================

# Git & Version Control
.git/
.gitignore
.gitattributes

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.gunicorn/
.cache/

# Virtual Environments
venv/
.venv/
env/
.env
.env.*
!.env.example

# Local Database Files & Storage
*.db
*.sqlite
*.sqlite3
uploads/*
!uploads/.gitkeep
storages/*
!storages/.gitkeep
images/*
!images/.gitkeep

# Documentation & IDE
.vscode/
.idea/
*.swp
README.md
.DS_Store
Thumbs.db
